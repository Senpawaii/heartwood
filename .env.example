# Copy to .env (same folder as this file) and edit. `pnpm start` reads it; no shell syntax needed.
# Everything is optional. Paths are relative to this folder, or absolute.

# Where the daemon keeps its database, skills and benchmark results.
HEARTWOOD_DATA_DIR=.heartwood

# Port and host. Keep 127.0.0.1 unless you set HEARTWOOD_TOKEN.
HEARTWOOD_PORT=7777
# HEARTWOOD_TOKEN=at-least-16-characters

# Folders of skills the Lab offers (separate several with ; on Windows or : elsewhere).
# HEARTWOOD_SKILL_DIRS=grimoire/skills

# Benchmarks (Analyze) and skill rewrites (Evolve). Both use omp, which must be on PATH.
# Without these two settings those buttons answer "not configured".
# HEARTWOOD_BENCH_AGENT=omp
# HEARTWOOD_BENCH_MODEL=anthropic/claude-sonnet-5-5:low
# HEARTWOOD_REWRITER=omp
# HEARTWOOD_REWRITER_MODEL=anthropic/claude-sonnet-5-5:low
